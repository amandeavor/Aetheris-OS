#!/bin/sh
exec 2>&1

# Ensure runtime directory exists
mkdir -p /var/lib/velocitymind

# If already running (e.g., started early by core-services), wait on it to prevent runsv from crash-looping
if pgrep -x "velocitymind" >/dev/null; then
    echo "velocitymind: Already running (started early by core-services). Monitoring..."
    pid=$(pgrep -o -x "velocitymind")
    while kill -0 "$pid" 2>/dev/null; do
        sleep 2
    done
    echo "velocitymind: Early instance exited. Starting supervised instance..."
fi

# Run velocitymind daemon in the foreground
exec /usr/bin/velocitymind

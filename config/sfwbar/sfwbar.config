# Sfwbar layout configuration
# File: ~/.config/sfwbar/sfwbar.config

window {
  layer = "top"
  exclusive = true
  anchor = "bottom"
}

layout {
  # Taskbar for open applications
  taskbar {
    style = "task"
    active = "task-active"
    sort = "id"
  }

  # Spacer to push clock to the right
  label {
    value = ""
    style = "spacer"
  }

  # System tray for background services
  tray {
    style = "tray"
  }

  # Numeric clock
  label {
    value = Time("%H:%M")
    style = "clock"
  }
}
